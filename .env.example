# Database (khớp với docker-compose.yml)
DATABASE_URL="postgresql://stepslms:stepslms@localhost:5434/stepslms?schema=public"

# Xac thuc ung dung VPS
# Sinh secret: openssl rand -base64 32
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-cua-ban"
AUTH_TRUST_HOST=true

# Ứng dụng luôn chạy trên các bảng quan hệ, không cần khai báo gì thêm.
# Chỉ đặt STORAGE_MODE=kv khi cần lùi về cách lưu cũ (khối JSON trong bảng
# vps_app_state) lúc cắt chuyển một hệ thống đang chạy tầng cũ mà gặp sự cố.

# Container startup (production)
RUN_MIGRATIONS=true
RUN_SYLLABUS_IMPORT=false
RUN_SEED=false

# Tài khoản seed mặc định
SEED_MODE="bootstrap"
SEED_CENTER_NAME="STEPS English Center"
SEED_ADMIN_NAME="Quản trị STEPS"
SEED_ADMIN_EMAIL="admin@steps.vn"
SEED_ADMIN_PASSWORD="thay-bang-mat-khau-manh"

# Production phai giu false. Chi bat true khi can cac nut dang nhap demo.
ALLOW_DEMO_LOGIN=false

# SePay + HĐĐT (PLAN_SEPAY_EINVOICE_LMS)
SEPAY_API_TOKEN=""
SEPAY_WEBHOOK_SECRET=""
# Token cho API chỉ đọc /api/v1/readonly (trợ lý AI). Để trống = tắt API. Tạo: openssl rand -hex 32
LMS_READONLY_API_TOKEN=""
# Token cho API thao tác /api/v1/ops (trợ lý nhập sao kê 2 bước). Để trống = tắt. Khác token chỉ đọc.
LMS_OPS_API_TOKEN=""
SEPAY_BANK="VCB"
SEPAY_BANK_ACCOUNT=""
SEPAY_ACCOUNT_NAME="STEPS EDUCATION"
SEPAY_ENV="development"

# Domain công khai thật, dùng dựng link tuyệt đối gửi qua Zalo (link trang thanh toán
# công khai). Chưa chốt domain (Q8/Q9 của plan tích hợp SePay/MISA/Zalo) — để trống thì
# tin "yêu cầu thanh toán" không gửi được, các luồng khác không bị ảnh hưởng.
PUBLIC_BASE_URL=""
