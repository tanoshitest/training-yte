{
  "name": "steps-lms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx cloudflare/vps-server.ts",
    "dev:next": "next dev",
    "build": "prisma generate && node scripts/build.mjs",
    "start": "next start",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "deploy:vps": "docker build -t steps-lms .",
    "deploy:full": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "demo:build": "node scripts/build-cloudflare-syllabus.mjs",
    "demo:check": "npm run demo:build && wrangler deploy --dry-run --minify",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:portal": "prisma generate && tsx --test tests/portal-data.test.ts tests/public-consultation.test.ts",
    "test:activities": "tsx --test tests/activity-registry.test.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "syllabus:audit": "tsx scripts/syllabus-audit.ts",
    "syllabus:import": "tsx scripts/import-syllabuses.ts",
    "syllabus:verify": "tsx scripts/verify-syllabuses.ts",
    "test:storage": "tsx scripts/prepare-storage-test-db.ts && tsx --test tests/relational-storage.test.ts",
    "storage:sync": "tsx scripts/migrate-kv-to-relational.ts",
    "storage:verify": "tsx scripts/migrate-kv-to-relational.ts --verify"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "html2canvas-pro": "^2.4.1",
    "lucide-react": "^1.31.0",
    "next": "^15.5.24",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.2.20",
    "prisma": "^7.9.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.11",
    "uqr": "^0.1.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.4",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdfmake": "^0.2.12",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.24",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.127.1"
  }
}
