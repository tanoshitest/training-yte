# STEPS LMS - self-hosted VPS image.
# The UI/API formerly deployed as a Cloudflare Worker now runs as a Node service;
# KV and Durable Object state are persisted in the VPS PostgreSQL database.
#
# DAY LA FILE PRODUCTION THAT DANG DUNG: deploy/docker-compose.yml build bang
# Dockerfile nay (khong phai Dockerfile o goc repo, cai do la app Next.js
# chua duoc noi vao deploy pipeline nao). Xem docs/system-architecture.md.

FROM node:22-alpine AS base
RUN (apk add --no-cache libc6-compat || apk add --no-cache libc6-compat) \
 && npm install -g npm@11.6.2 --fetch-timeout=60000 --fetch-retries=5 \
 && npm cache clean --force

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --fetch-timeout=60000 --fetch-retries=5 && npm cache clean --force

FROM deps AS builder
COPY prisma ./prisma
COPY prisma.config.ts ./prisma.config.ts
ENV DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build"
RUN ./node_modules/.bin/prisma generate

FROM deps AS production-deps
RUN npm prune --omit=dev --ignore-scripts \
 && npm cache clean --force \
 && rm -rf node_modules/@prisma/studio-core/dist/ui \
              node_modules/@prisma/dev/dist/runtime-assets \
              node_modules/@types

FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

COPY --from=production-deps /app/node_modules ./node_modules
COPY --from=builder /app/src/generated ./src/generated
COPY package.json tsconfig.json prisma.config.ts ./
COPY prisma ./prisma
COPY cloudflare ./cloudflare
COPY src/lib/money-words.ts ./src/lib/money-words.ts
COPY scripts/import-syllabuses.ts ./scripts/import-syllabuses.ts
COPY src/data/syllabuses ./src/data/syllabuses
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.sh \
  && chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["./node_modules/.bin/tsx", "cloudflare/vps-server.ts"]
