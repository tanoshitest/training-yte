// ------------------------------------------------------------
// TÍCH HỢP SEPAY / MISA / ZALO (khối `integrations:steps-demo` và `zalo-messages:steps-demo`)
// ------------------------------------------------------------

/// Cấu hình ba tích hợp (SePay webhook, MISA meInvoice, Zalo OA ZBS). Một dòng duy nhất,
/// khóa cố định "integration". Bí mật lưu dạng ciphertext đục (mã hoá ở Phase 3).
model OpsIntegrationSetting {
  id        String @id
  payload   Json
  updatedAt String
  updatedBy String

  @@map("integration_settings")
}

/// Log gửi tin Zalo OA (ZBS Template Message). Khóa duy nhất theo (kind, receivableId,
/// invoiceId) chặn gửi trùng: một khoản phải thu chỉ có đúng một tin yêu cầu thanh toán,
/// một hóa đơn chỉ có đúng một tin thông báo (Phase 7).
model OpsZaloMessageLog {
  id            String  @id
  position      Int
  kind          String
  receivableId  String?
  invoiceId     String?
  studentId     String
  phone         String
  templateId    String
  status        String
  providerMsgId String?
  errorCode     String?
  errorMessage  String?
  createdAt     String
  sentAt        String?
  deliveredAt   String?
  /// Mốc bắt đầu xử lý — cứu dòng kẹt PROCESSING khi tiến trình chết giữa chừng (Phase 7).
  processingAt  String?
  /// Ảnh chụp nội dung tin đã gửi, để xem lại ở Nhật ký Zalo dù dữ liệu gốc đã đổi sau đó.
  /// Giá trị điền vào mẫu ZBS, dạng JSON text.
  templateData  String?
  studentName   String?
  studentCode   String?
  className     String?
  /// Số điện thoại thô lấy từ hồ sơ trước khi chuẩn hoá về dạng 84xxxxxxxxx.
  rawPhone      String?
  requestedBy   String?
  attemptCount  Int     @default(0)
  lastAttemptAt String?
  /// sent_time do Zalo trả về khi nhận tin.
  providerSentTime String?
  /// Webhook Zalo gần nhất của tin này: mốc nhận và nội dung gốc (đã cắt ngắn).
  webhookAt     String?
  webhookPayload String?

  @@unique([kind, receivableId, invoiceId])
  @@index([position])
  @@index([studentId])
  @@map("zalo_message_logs")
}

// ------------------------------------------------------------
// SYLLABUS VÀ CÁC LẦN CHẠY DỮ LIỆU MỘT LẦN
// ------------------------------------------------------------

/// Danh mục syllabus — một tập thực thể nên mỗi syllabus một dòng.
/// Trước đây nằm trong khối `do:catalog:steps-demo:items` của `vps_app_state`.
model OpsSyllabusCatalogItem {
  id              String  @id
  position        Int
  code            String
  name            String
  /// `null` ở đây là giá trị thật trong dữ liệu (syllabus chưa gắn cấp học).
  levelId         String?
  level           String
  description     String
  status          String
  totalCourseDays Int
  sortOrder       Int
  createdAt       String
  updatedAt       String

  @@index([position])
  @@map("syllabus_catalog")
}

/// Nội dung giáo trình của một syllabus.
///
/// Giữ nguyên dạng tài liệu thay vì tách thành bảng, vì `cloudflare/syllabus-storage.ts`
/// luôn đọc và ghi **trọn gói** (`storage.get("document")` / `put("document", …)`) chứ
/// không truy vấn từng bài học riêng lẻ. Tách nhỏ một tài liệu chỉ được đọc trọn gói
/// sẽ thêm việc mà không thêm khả năng nào.
model OpsSyllabusDocument {
  syllabusId String   @id
  document   Json
  updatedAt  DateTime @updatedAt

  @@map("syllabus_documents")
}

/// Các bước xử lý dữ liệu chạy đúng một lần của `worker.ts` (bù số dư buổi, ngày
/// khai giảng khóa…). Trước đây là các cờ `kv:migration:*` trong `vps_app_state`.
model OpsDataMigration {
  key   String @id
  /// Thời điểm chạy, chuỗi ISO đúng như app ghi.
  ranAt String

  @@map("data_migrations")
}

// ------------------------------------------------------------
// DỮ LIỆU RIÊNG CỦA TỪNG HỌC VIÊN TRÊN CỔNG HỌC
// ------------------------------------------------------------

/// Tiến độ hoàn thành từng mục học của một học viên.
/// Trước đây là khối `progress:<mã học viên>`.
model OpsStudentProgress {
  studentId String
  itemId    String
  completed Boolean

  @@id([studentId, itemId])
  @@map("student_progress")
}

/// Kết quả từng lượt chơi hoạt động. `worker.ts` giữ 100 lượt mới nhất cho mỗi
/// học viên, mới nhất đứng đầu — `position` giữ đúng thứ tự đó.
model OpsStudentActivityAttempt {
  id              String @id
  studentId       String
  position        Int
  syllabusId      String
  activityId      String
  score           Float
  accuracy        Float
  durationSeconds Float
  /// Câu trả lời tùy theo loại hoạt động, không có khuôn cố định nên giữ dạng JSON.
  answers         Json
  completedAt     String

  @@index([studentId, position])
  @@map("student_activity_attempts")
}

/// Trạng thái màn hình học của học viên (ví dụ syllabus đang mở).
/// Trước đây là khối `student:<mã học viên>`.
model OpsStudentAppState {
  studentId String @id
  state     Json

  @@map("student_app_state")
}
