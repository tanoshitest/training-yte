  amount        Decimal @db.Decimal(15, 0)
  buyerName     String
  lookupCode    String?
  status        String
  retryCount    Int
  lastError     String?
  createdAt     String
  issuedAt      String?
  /// Các cột dưới đây phục vụ phát hành hóa đơn thật qua MISA meInvoice (Phase 6).
  buyerTaxCode      String?
  buyerAddress      String?
  buyerEmail        String?
  pdfUrl            String?
  xmlUrl            String?
