# local agent config
.claude/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# du lieu import (co thong tin ca nhan hoc vien) - khong day len git
/data/

# Local database safety snapshots
/backups/
/tmp/production-backups/

# Cloudflare / OpenNext build output and local state
/.open-next/
/.wrangler/
/cloudflare-env.d.ts
